{
  "name": "stocksure-api",
  "version": "0.1.0",
  "private": true,
  "description": "StockSure backend: Fastify API + Kafka worker on Aiven PostgreSQL, Kafka and OpenSearch",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prestart": "node scripts/patch-kafkajs.ts --check",
    "predev": "node scripts/patch-kafkajs.ts --check",
    "preworker": "node scripts/patch-kafkajs.ts --check",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "worker": "node --env-file-if-exists=.env src/worker.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "node --watch --env-file-if-exists=.env src/worker.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "setup:kafka": "node --env-file-if-exists=.env scripts/setup-kafka.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "seed:nursery": "node --env-file-if-exists=.env scripts/seed-nursery.ts",
    "seed:layout": "node --env-file-if-exists=.env scripts/seed-layout.ts",
    "reindex": "node --env-file-if-exists=.env scripts/reindex.ts",
    "warmup": "node --env-file-if-exists=.env scripts/warmup.ts",
    "kafka:probe": "node --env-file-if-exists=.env scripts/kafka-probe.ts",
    "contract:check": "node --env-file-if-exists=.env scripts/contract-check.ts",
    "race-test": "node --env-file-if-exists=.env scripts/race-test.ts",
    "smoke:payments": "node --env-file-if-exists=.env scripts/smoke-payments.ts",
    "smoke:google": "node --env-file-if-exists=.env scripts/smoke-google.ts",
    "demo:up": "node --env-file-if-exists=.env scripts/demo-up.ts",
    "demo:reset": "node --env-file-if-exists=.env scripts/demo-reset.ts",
    "demo:fixture": "node --env-file-if-exists=.env scripts/demo-fixture.ts",
    "export:openapi": "node --env-file-if-exists=.env scripts/export-openapi.ts",
    "judge-demo": "node --env-file-if-exists=.env scripts/judge-demo.ts",
    "pos-sim": "node --env-file-if-exists=.env scripts/pos-simulator.ts",
    "bad-event": "node --env-file-if-exists=.env scripts/bad-event.ts",
    "images:fetch": "node --env-file-if-exists=.env scripts/fetch-images.ts",
    "images:verify": "node --env-file-if-exists=.env scripts/verify-images.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --env-file-if-exists=.env --test test/domain.test.ts test/zoho.test.ts test/zoho-mock.test.ts test/migrations.test.ts test/f2-auth.test.ts test/f3-ratelimit.test.ts test/f4-swagger.test.ts test/env-docs.test.ts test/f8-orders-me.test.ts test/f12-patch-safety.test.ts test/nursery-inactive.test.ts test/auth-features.test.ts test/payments.test.ts test/maps.test.ts test/delivery.test.ts test/chat.test.ts test/google-auth.test.ts test/plant-images.test.ts",
    "test:db": "node --env-file-if-exists=.env --test test/auth.test.ts test/demo-routes.test.ts test/swagger.test.ts test/sql.test.ts && node --env-file-if-exists=.env test/t0-test.ts && node --env-file-if-exists=.env test/t1-test.ts && node --env-file-if-exists=.env test/t2-test.ts && node --env-file-if-exists=.env test/t3-test.ts && node --env-file-if-exists=.env test/t4-test.ts",
    "test": "npm run test:unit && npm run test:db",
    "test:sql": "node --env-file-if-exists=.env --test test/sql.test.ts",
    "postinstall": "node scripts/patch-kafkajs.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "fastify": "^5.2.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.3"
  }
}
