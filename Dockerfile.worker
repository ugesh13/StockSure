# Node 22 on Alpine
FROM node:22-alpine

WORKDIR /app

# Copy dependency manifests
COPY package.json package-lock.json ./

# Install dependencies strictly with npm ci (triggers postinstall patch-kafkajs)
RUN npm ci

# Copy application files
COPY tsconfig.json ./
COPY src ./src
COPY sql ./sql
COPY scripts ./scripts
COPY catalogue.psv ./

# Run patch check
RUN node scripts/patch-kafkajs.ts --check

ENV NODE_ENV=production

# Run as non-root user
USER node

CMD ["node", "src/worker.ts"]
