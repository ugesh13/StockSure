# Node 22 on Alpine
FROM node:22-alpine

WORKDIR /app

# Copy dependency manifests
COPY package.json package-lock.json* ./

# Install dependencies (triggers postinstall patch-kafkajs)
RUN npm install

# Copy application files
COPY tsconfig.json ./
COPY src ./src
COPY sql ./sql
COPY scripts ./scripts
COPY catalogue.psv ./

# Run patch check
RUN node scripts/patch-kafkajs.ts --check

ENV NODE_ENV=production

CMD ["node", "src/worker.ts"]
