# Copy to .env (git-ignored) and fill in. Names only here: NEVER commit real values.
# Put the same values in your hosting platform's secret settings.

# ---------- server ----------
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
HOLD_MINUTES=10
LOW_STOCK=3
STALE_SECONDS=60
RELAY_INTERVAL_MS=400
SWEEP_INTERVAL_MS=30000
SEARCH_TIMEOUT_MS=1500

# ---------- Aiven PostgreSQL ----------
# Service URI from the Aiven console (contains the password).
DATABASE_URL=
PG_SSL=require
# Optional: base64 of the Aiven project CA (ca.pem) to verify the server certificate.
# If empty the connection is still encrypted but the certificate is not verified.
PG_CA_B64=
# API pool size (default: 5). The worker uses 3 (set WORKER_PG_POOL_MAX to change). Aiven free allows 20 connections in total.
PG_POOL_MAX=5

# ---------- Aiven Kafka ----------
# host:port. Certificate auth port and SASL port are different on Aiven. Use the one that matches below.
KAFKA_BROKERS=
# base64 of ca.pem (needed for both auth methods)
KAFKA_CA_B64=
# A) Client certificate auth: base64 of service.cert and service.key
KAFKA_CERT_B64=
KAFKA_KEY_B64=
# B) SASL auth (used instead of A when set). Mechanism: scram-sha-256 (default), scram-sha-512 or plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SASL_MECHANISM=scram-sha-256
# Must equal the partitions of the topics created by `npm run setup:kafka`
KAFKA_PARTITIONS=2
KAFKA_CLIENT_ID=stocksure

# ---------- Aiven OpenSearch ----------
# https://avnadmin:PASSWORD@host:port  (contains the login)
OPENSEARCH_URL=
OPENSEARCH_INDEX=products_v1

# ---------- keys for staff and admin routes (8+ characters each) ----------
STAFF_KEY=
ADMIN_TOKEN=

# ---------- optional switches (API process) ----------
# Run exactly ONE relay. If you ever start a second API instance, set RUN_RELAY=false on it.
RUN_RELAY=true
RUN_SWEEPER=true
# Allow header-based identity for demo customers 1..20 without a session token
DEMO_MODE=true
# Allow Swagger documentation (/docs) in production
DOCS_ENABLED=false
# Authorize destructive database reset (e.g. seed --reset)
ALLOW_DESTRUCTIVE=0

# ---------- Zoho Inventory Integration (optional) ----------
# Client credentials from Zoho API Console
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in/inventory/v1

# ---------- Payments (Mock by default, or Razorpay test mode) ----------
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_TTL_MINUTES=15

# ---------- Google Maps Server Key ----------
GOOGLE_MAPS_SERVER_KEY=

# ---------- Delivery Configuration ----------
DELIVERY_MAX_KM=15
DELIVERY_BASE_FEE=40
DELIVERY_PER_KM=8
FREE_DELIVERY_ABOVE=999

# ---------- Chatbot LLM Provider (none by default) ----------
CHAT_LLM_PROVIDER=none

